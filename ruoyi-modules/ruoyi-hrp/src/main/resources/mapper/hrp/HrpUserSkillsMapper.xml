<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.hrp.mapper.HrpUserSkillsMapper">

    <select id="selectVoListByUserIds" resultType="org.dromara.hrp.domain.vo.HrpUserSkillsVo">
        select * from hrp_user_skills where user_id in
        <foreach collection="userIds" item="item" open="(" close=")" separator=",">
            #{item}
        </foreach>
    </select>
</mapper>
