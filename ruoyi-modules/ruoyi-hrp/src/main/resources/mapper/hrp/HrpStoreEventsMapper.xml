<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.hrp.mapper.HrpStoreEventsMapper">

    <select id="selectVoListByStoreAndDate" resultType="org.dromara.hrp.domain.vo.HrpStoreEventsVo">
        select * from hrp_store_events where store_id = #{storeId} and event_date between #{startDate} and #{endDate}
    </select>

</mapper>
